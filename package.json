{
  "name": "@kontent-ai/data-ops",
  "version": "2.8.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "checkTests": "tsc --project tsconfig.tests.jsonc",
    "eslint": "eslint src",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "biome:fix:unsafe": "biome check --write --unsafe",
    "biome:ci": "biome ci",
    "start": "pnpm build && node ./build/src/index.js",
    "test:integration": "pnpm build && vitest run --config=vitest.config.integration.js",
    "test:advancedDiff": "pnpm build && vitest run --config=vitest.config.integration.js tests/integration/diff/advancedDiff.test.ts",
    "test:unit": "vitest run --config=vitest.config.unit.js",
    "test:unit:watch": "vitest run --config=vitest.config.unit.js --watch",
    "export:testEnvs": "node exportTestEnvironments.js"
  },
  "files": [
    "./build/**/*"
  ],
  "main": "./build/src/public.js",
  "types": "./build/src/public.d.ts",
  "bin": {
    "data-ops": "./build/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontent-ai/data-ops.git"
  },
  "author": "Kontent.ai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kontent-ai/data-ops/issues"
  },
  "homepage": "https://github.com/kontent-ai/data-ops#readme",
  "exports": {
    ".": "./build/src/public.js"
  },
  "dependencies": {
    "@kontent-ai/core-sdk": "^10.12.11",
    "@kontent-ai/delivery-sdk": "^16.4.8",
    "@kontent-ai/management-sdk": "^8.5.7",
    "@kontent-ai/migration-toolkit": "^3.2.5",
    "@kontent-ai/rich-text-resolver": "3.1.0",
    "@kontent-ai/rich-text-resolver-markdown": "^3.0.3",
    "@kontent-ai/rich-text-resolver-react": "^3.0.4",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "chalk": "^6.0.1",
    "js-yaml": "^5.4.3",
    "node-stream-zip": "^1.16.0",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-pattern": "^5.9.0",
    "uuid": "^14.0.3",
    "yargs": "^18.2.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@kontent-ai/biome-config": "^0.7.3",
    "@kontent-ai/eslint-config": "^3.0.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "minimist": "^1.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
